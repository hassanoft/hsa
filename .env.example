# =============================================================
# H$Λ BOT — Configuration d'environnement
# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# Ne mettez JAMAIS de vraies clés dans ce fichier .env.example.
# =============================================================

# ---- Identité du bot ----
BOT_NAME=H$Λ BOT
PREFIX=/

# ---- Propriétaire (OWNER) ----
# Numéro WhatsApp du propriétaire, format international SANS "+" ni espaces
# Exemple : 2250700000000
OWNER_NUMBER=

# ---- Connexion WhatsApp (pairing code) ----
# Numéro WhatsApp qui sera utilisé par LE BOT lui-même pour se connecter.
# Requis sur Render (pas de terminal interactif) : le code sera affiché dans les logs.
# Optionnel en local/Termux : si absent, le bot le demandera dans le terminal.
WHATSAPP_NUMBER=

# ---- Serveur HTTP (Render) ----
PORT=3000

# ---- Stockage / persistance ----
# Dossier où sont stockées les données persistantes (base JSON + session auth).
# Sur Render, faites pointer ceci vers un "Persistent Disk" monté (ex: /var/data).
DATA_DIR=./data
AUTH_DIR=./auth
# "file" (par défaut, dossier multi-fichiers Baileys) ou "database" (JSON via DATA_DIR)
AUTH_STORAGE=file

# ---- Intelligence Artificielle : fournisseurs multiples ----
# Le bot essaiera les fournisseurs dans l'ordre suivant :
#   1. OpenRouter
#   2. Groq
#   3. Cerebras
#   4. Gemini
#   5. OpenAI
# Si un fournisseur échoue (quota épuisé, erreur 429…), il passe au suivant.
#
# Chaque variable de clé accepte :
#   - une clé unique :                GEMINI_API_KEY=AIza...
#   - plusieurs clés séparées par des virgules :  GEMINI_API_KEY=cle1,cle2,cle3
#   - ou des clés suffixées _2, _3 … :          GEMINI_API_KEY=cle1
#                                               GEMINI_API_KEY_2=cle2
#                                               GEMINI_API_KEY_3=cle3
#
# Vous pouvez laisser vides les fournisseurs que vous n'utilisez pas.
# Au moins UN fournisseur doit avoir une clé pour activer les commandes IA.

# --- OpenRouter (recommandé, accès à de nombreux modèles) ---
OPENROUTER_API_KEY=
# Modèle par défaut (voir https://openrouter.ai/models)
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Groq ---
GROQ_API_KEY=
# Modèle par défaut (voir https://console.groq.com/docs/models)
GROQ_MODEL=llama3-8b-8192

# --- Cerebras ---
CEREBRAS_API_KEY=
# Modèle par défaut
CEREBRAS_MODEL=llama3.1-8b

# --- Gemini (Google) ---
GEMINI_API_KEY=
# Modèle par défaut (vérifiez le nom exact, ex: gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# --- OpenAI (direct) ---
OPENAI_API_KEY=
# Modèle par défaut
OPENAI_MODEL=gpt-4o-mini

# ---- Génération d'image (/imagine) ----
# Ces paramètres sont indépendants du fournisseur de texte.
# Ils utilisent généralement OpenAI DALL·E, mais vous pouvez adapter l'URL.
AI_IMAGE_API_URL=https://api.openai.com/v1/images/generations
AI_IMAGE_MODEL=dall-e-3

# ---- Synthèse vocale (/tts) ----
TTS_API_URL=
TTS_API_KEY=

# ---- Image ----
REMOVEBG_API_KEY=
REMOVEBG_API_URL=https://api.remove.bg/v1.0/removebg
IMAGE_UPSCALE_API_URL=
IMAGE_UPSCALE_API_KEY=

# ---- Téléchargement (yt / tiktok / instagram / facebook / twitter) ----
# Branchez ici une API tierce conforme aux CGU des plateformes concernées.
DOWNLOAD_API_URL=
DOWNLOAD_API_KEY=

# ---- Météo (/weather) ----
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# ---- Devises (/currency) ----
CURRENCY_API_URL=https://api.exchangerate.host/latest

# ---- Modération : anti-NSFW (/antinsfw) ----
NSFW_API_URL=
NSFW_API_KEY=

# ---- FFmpeg ----
# Laissez vide pour auto-détection (system ffmpeg puis ffmpeg-static en secours)
FFMPEG_PATH=

# ---- Divers ----
# Nombre max de commandes par utilisateur / fenêtre de temps (anti-spam)
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=10000